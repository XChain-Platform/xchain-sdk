# xchain-sdk configuration: copy to .env and fill in values.
# Developer SDK for generating XChain actions. These variables provide default
# endpoints; most SDK calls also accept per-call overrides in code.

# Required: default coin and network (e.g. bitcoin-regtest).
NETWORK=bitcoin-regtest

# Optional: port for the optional SDK helper API (default 3005).
# SDK_API_PORT=3005

# API key protecting every SDK helper-API method except ping. Methods reject
# requests (401) unless the caller presents this key as
# "Authorization: Bearer <key>" (applies even when left unset).
SDK_API_KEY=your-key-here

# Optional: CORS allowed origins for the helper API (default disabled).
# A comma-separated ALLOWLIST; each listed origin is answered with itself, and an
# unlisted one gets no header at all. `*` means any origin ONLY as the entire
# value - mixed into a list it is treated as a literal entry and grants nothing.
# CORS_ORIGIN=*
# CORS_ORIGIN=capacitor://localhost,https://localhost,https://wallet.xchain.io

# Optional: helper-API DoS guards (src/apiGuards.js). Each one falls back to its
# default on a junk value, because a NaN limit compared with > never fires: the
# fallback IS the guard, not a convenience.

# Maximum JSON-RPC calls in one array (batch) body (default 20). A non-numeric or
# non-positive value falls back to 20; no value disables the cap.
# SDK_API_MAX_BATCH=20

# Requests per window per credential, counted per source address when the caller
# is unauthenticated (default 300). A non-numeric or negative value falls back to
# 300; an explicit 0 disables the limiter and is the ONLY way to turn it off.
# SDK_API_RATE_LIMIT=300

# Length of the fixed rate-limit window in milliseconds (default 60000). A
# non-numeric or non-positive value falls back to 60000.
# SDK_API_RATE_WINDOW_MS=60000

# --- Service endpoints --------------------------------------------------------
# Optional: xchain-explorer location.
EXPLORER_URL=127.0.0.1
EXPLORER_PORT=8080

# Optional: xchain-encoder location.
ENCODER_URL=127.0.0.1
ENCODER_PORT=3003

# Optional: xchain-hub location. HUB_URL is a full URL; HUB_API_HOST/HUB_PORT
# are the host/port form used by some SDK paths.
# HUB_URL=http://127.0.0.1:10000
# HUB_API_HOST=127.0.0.1
# HUB_PORT=10000

# Optional: explorer WebSocket endpoint for live updates.
# WEBSOCKET_URL=127.0.0.1
# WEBSOCKET_PORT=3007
